--- !u!114 &464895219
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 464895210}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b7273f3818a35b29b5fe1a3323cf106, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  Sequence:
  - Speaker: {fileID: 464895216}
    Line: ' Oh, oh my stars! '
    Duration: 3
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: "The memories\u2026 thank you, little one... "
    Duration: 3
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: 'This pleases and settles me greatly. '
    Duration: 3
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: As a reward, I will grant you my magnum opus of comedy
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: The joke I could ever get myself to perform
    Duration: 3
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: I forged it specifficly to invoke the king's laughter
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: So surely, thau must jest, perform the ultimate joke
    Duration: 3
    Audio: {fileID: 0}
  OnStart:
    m_PersistentCalls:
      m_Calls: []
  OnFinish:
    m_PersistentCalls:
      m_Calls: []
