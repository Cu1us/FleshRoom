  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  Sequence:
  - Speaker: {fileID: 464895216}
    Line: 'I see you figured out the secret method of obtaining the weiner. '
    Duration: 3
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: Admirable effort, little one.
    Duration: 3
    Audio: {fileID: 0}
  OnStart:
    m_PersistentCalls:
      m_Calls: []
  OnFinish:
    m_PersistentCalls:
      m_Calls: []
