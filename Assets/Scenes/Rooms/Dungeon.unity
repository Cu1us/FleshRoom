--- !u!114 &464895215
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 464895210}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b7273f3818a35b29b5fe1a3323cf106, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  Sequence:
  - Speaker: {fileID: 464895216}
    Line: I'm gross, don't look  at me!
    Duration: 3
    Audio: {fileID: 8300000, guid: 8d3fed6c9638eec4a8f6408938c9ca0a, type: 3}
  - Speaker: {fileID: 464895216}
    Line: If only you had seen me in my prime
    Duration: 3
    Audio: {fileID: 8300000, guid: 8d3fed6c9638eec4a8f6408938c9ca0a, type: 3}
  - Speaker: {fileID: 464895216}
    Line: Are you my successor?
    Duration: 3
    Audio: {fileID: 8300000, guid: 8d3fed6c9638eec4a8f6408938c9ca0a, type: 3}
  - Speaker: {fileID: 464895216}
    Line: I never got the king to laugh
    Duration: 3
    Audio: {fileID: 8300000, guid: 8d3fed6c9638eec4a8f6408938c9ca0a, type: 3}
  - Speaker: {fileID: 464895216}
    Line: I gave up
    Duration: 2
    Audio: {fileID: 8300000, guid: 8d3fed6c9638eec4a8f6408938c9ca0a, type: 3}
  - Speaker: {fileID: 464895216}
    Line: Then after I got here I figured it out
    Duration: 3
    Audio: {fileID: 8300000, guid: 8d3fed6c9638eec4a8f6408938c9ca0a, type: 3}
  - Speaker: {fileID: 464895216}
    Line: Oh sorry, have I been rambling?
    Duration: 3
    Audio: {fileID: 8300000, guid: 8d3fed6c9638eec4a8f6408938c9ca0a, type: 3}
  - Speaker: {fileID: 464895216}
    Line: The discomfort from the shackle must be messing with my head
    Duration: 4
    Audio: {fileID: 8300000, guid: 8d3fed6c9638eec4a8f6408938c9ca0a, type: 3}
  OnStart:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 895929971}
        m_TargetAssemblyTypeName: CharacterAnimator, Assembly-CSharp
        m_MethodName: StartTalk
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  OnFinish:
    m_PersistentCalls:
      m_Calls:
