  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  Sequence:
  - Speaker: {fileID: 511258428}
    Line: No point - the lock is greased shut.
    Duration: 2.5
    Audio: {fileID: 0}
  OnStart:
    m_PersistentCalls:
      m_Calls: []
  OnFinish:
    m_PersistentCalls:
      m_Calls: []
--- !u!114 &1165218115
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1165218110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b7273f3818a35b29b5fe1a3323cf106, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  Sequence:
  - Speaker: {fileID: 511258428}
    Line: The sole shackle stinks of dried grease.
    Duration: 2
    Audio: {fileID: 0}
  - Speaker: {fileID: 511258428}
    Line: I can smell it from over here.
    Duration: 1.5
    Audio: {fileID: 0}
  OnStart:
    m_PersistentCalls:
      m_Calls: []
  OnFinish:
    m_PersistentCalls:
      m_Calls: []
--- !u!114 &1165218116
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1165218110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b7273f3818a35b29b5fe1a3323cf106, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  Sequence:
  - Speaker: {fileID: 464895216}
    Line: 'Oh yes, yes, I am being lubricated! '
    Duration: 3
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: 'Thank you, little one. Yes, yes, I am now indebted to you, little one. '
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: 'However, if you are willing, I have one more favour to ask. '
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: ' I do so dearly miss a certain dish my old friend used to cook for me'
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: before I relinquished myself to the basement.
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: "It contains a secret ingredient that no one else can find\u2026 "
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: only our kind knows how to find them.
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: ' Pardon my prudeness, but by all means; '
    Duration: 4
    Audio: {fileID: 0}
  - Speaker: {fileID: 464895216}
    Line: touch thine self and see what you find.
    Duration: 4
    Audio: {fileID: 0}
  OnStart:
    m_PersistentCalls:
      m_Calls: []
  OnFinish:
    m_PersistentCalls:
      m_Calls: []
